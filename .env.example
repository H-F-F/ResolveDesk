# ResolveDesk 环境配置模板
# 复制为 .env 后按需修改：cp .env.example .env  （Windows: copy .env.example .env）

# 运行环境：local / docker / production
APP_ENV=local
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 前端调用后端 API 的地址
FRONTEND_API_BASE=http://localhost:8000

# ---------------------------------------------------------------
# 模型提供方：offline（本地演示）或 openai_compatible（接入真实模型）
# 离线模式无需任何 API Key，适合演示与测试；真实模式需填写下方配置
# ---------------------------------------------------------------
CHAT_PROVIDER=offline
EMBEDDING_PROVIDER=offline

# OpenAI Compatible 接口配置（例如阿里云百炼 DashScope）
MODEL_API_BASE=
MODEL_API_KEY=
CHAT_MODEL_NAME=
EMBEDDING_MODEL_NAME=
MODEL_TIMEOUT_SECONDS=60
MODEL_TEMPERATURE=0.2
MODEL_VERIFY_SSL=true

# ---------------------------------------------------------------
# 检索与分块
# 注意：EMBEDDING_DIMENSION 仅为离线模式的向量维度。
# 使用真实嵌入模型时，系统会自动探测模型实际输出维度并覆盖该配置。
# 切换嵌入模型后如遇维度不一致，调用 POST /reset 或删除 storage/ 目录。
# ---------------------------------------------------------------
CHROMA_COLLECTION=it_knowledge_base
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.22
RAG_LEXICAL_SCORE_THRESHOLD=0.2
CHUNK_SIZE=700
CHUNK_OVERLAP=120
EMBEDDING_DIMENSION=1536

# 可选追踪：接入 LangSmith 后自动启用可观测性
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=resolvedesk

# 存储目录（默认即可，无需修改）
# STORAGE_DIR=storage
# VECTOR_STORE_DIR=storage/chroma
# SQLITE_PATH=storage/app.db
# LOGS_DIR=storage/logs
# KNOWLEDGE_BASE_DIR=data/knowledge_base
